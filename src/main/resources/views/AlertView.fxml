<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" styleClass="dialog-card" stylesheets="@../css/mainStyle.css" xmlns="http://javafx.com/javafx/26.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ScanHub.GUI.controllers.AlertController">
    <children>
        <VBox prefWidth="480.0" spacing="20.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label fx:id="lblHeader" styleClass="h2" text="You have unsaved changes">
                            <font>
                                <Font name="System Bold" size="21.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnExit" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#onExitBtnClick" prefHeight="33.0" prefWidth="33.0" styleClass="clear-btn" text="Button">
                     <graphic>
                              <Label styleClass="icon" text="✕">
                                  <font>
                                      <Font size="20.0" />
                                  </font>
                              </Label>
                     </graphic>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
                    </children>
                </HBox>
            <HBox>
               <children>

                      <Label fx:id="lblContent" styleClass="h3" text="Do you want to save them before closing?" wrapText="true">
                          <font>
                              <Font size="16.0" />
                          </font>
                      </Label>
               </children>
            </HBox>

                <HBox spacing="9.0">
                    <Button fx:id="btnCancel"   prefHeight="30.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            mnemonicParsing="false" onAction="#handleCancel" text="Cancel" />
                    <Button fx:id="btnBefore"   prefHeight="30.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            managed="false" visible="false"
                            mnemonicParsing="false" onAction="#handleBefore" text="Before" />
                    <Button fx:id="btnConfirm"  prefHeight="30.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            mnemonicParsing="false" onAction="#handleConfirm" text="Confirm">
                        <styleClass><String fx:value="primary-btn"/></styleClass>
                    </Button>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
